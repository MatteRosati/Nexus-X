# ---- Application security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ENV=production
ENABLE_API_DOCS=false
LOG_LEVEL=INFO

# The application refuses scans outside this comma-separated allowlist.
# Subdomains of an allowed domain are automatically accepted.
EASM_ALLOWED_DOMAINS=example.com,example.org
ALLOW_ARBITRARY_TARGETS=false
MAX_QUEUED_SCANS=100
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
SCAN_STALE_AFTER_MINUTES=60

# ---- Database ----
POSTGRES_DB=easm
POSTGRES_USER=easm
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://easm:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/easm

# ---- Collectors ----
COLLECTOR_TIMEOUT_SECONDS=20
CRTSH_MAX_RESPONSE_BYTES=5242880
CRTSH_MAX_ENTRIES=5000

# ---- Censys Platform API v3 ----
# Use a Personal Access Token (PAT), NOT the legacy API ID/API Secret pair.
CENSYS_ENABLED=false
CENSYS_PAT=
CENSYS_ORGANIZATION_ID=
CENSYS_MAX_RESULTS=100
CENSYS_MAX_CONCURRENCY=1

# ---- ZoomEye API ----
# Uses the API-KEY from your ZoomEye profile (Free tier gives 10k points/month).
ZOOMEYE_ENABLED=false
ZOOMEYE_API_KEY=D002F213-ad47-01a12-2bde-f37a769bcee
ZOOMEYE_MAX_RESULTS=50
ZOOMEYE_MAX_CONCURRENCY=1

# ---- Leak Lookup API ----
# Uses the API key from your Leak Lookup account to find leaked credentials.
LEAKLOOKUP_ENABLED=false
LEAKLOOKUP_API_KEY=6f2404018b1905a91bb3d4d964caa5e1

# ---- HTTP hardening ----
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
